---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Particles from '@/components/Particles.jsx';
import FeaturedWork from '@/components/FeaturedWork.astro';
import WorkCard from '@/components/WorkCard.astro';
import { SITE } from '@/site.config';
import { UI, type Locale } from '@/i18n';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const copy = UI[locale];
const prefix = locale === 'zh' ? '/zh' : '';
const allWork = await getCollection('work', ({ data }) => !data.draft);
const featured = allWork.find((entry) => entry.data.featured);
const supportingOrder = ['divine-echo', 'traces-of-evaluation', 'liquidity-compensation-operation', 'oyster-reef-revival'];
const supporting = allWork.filter((entry) => !entry.data.featured).sort((a, b) => supportingOrder.indexOf(a.id) - supportingOrder.indexOf(b.id));
const description = locale === 'zh' ? '肖怡彤的交互设计作品集，涵盖数字产品、AI 体验与互动媒体。' : SITE.description;
---

<BaseLayout title={locale === 'zh' ? '肖怡彤' : SITE.name} description={description} locale={locale}>
  <div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
    <Particles client:load className="" particleColors={["#f5f5f2"]} particleCount={200} particleSpread={10} speed={0.1} particleBaseSize={100} moveParticlesOnHover={true} alphaParticles={false} disableRotation={false} />
  </div>
  <div class="relative z-10">
    <section class="border-line border-b"><div class="mx-auto flex min-h-[70vh] max-w-7xl flex-col justify-end px-5 py-16 sm:px-8 sm:py-24">
      <h1 class:list={["font-display text-ink max-w-6xl leading-[0.9] font-semibold tracking-[-0.04em]", locale === 'zh' ? 'text-[clamp(2.6rem,8vw,6rem)]' : 'text-[clamp(2.2rem,8vw,6rem)]']} data-home-reveal>{copy.hero}<br /><span class="text-ink-soft">{copy.role}</span></h1>
      <div class="mt-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end"><p class="text-ink-soft max-w-xl text-lg leading-7">{copy.tagline}</p><a href="#work" class="text-ink border-line hover:border-ink active:translate-y-px w-fit rounded-full border px-5 py-3 font-mono text-xs uppercase transition">{copy.work} <span aria-hidden="true">↘</span></a></div>
    </div></section>
    <nav class="border-line border-b" aria-label={locale === 'zh' ? '页面目录' : 'Page directory'}><div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20"><ol class="divide-line divide-y border-y border-line" data-home-reveal>
      {[['#about', copy.directory[0]], ['#work', copy.directory[1]], ['#contact', copy.directory[2]]].map(([href, label]) => <li><a href={href} class="group flex items-center justify-between py-5 font-display text-2xl font-semibold tracking-[-0.035em] transition-colors hover:text-[#8bdcff] sm:text-4xl"><span>{label}</span><span class="transition-transform group-hover:translate-x-1">↘</span></a></li>)}
    </ol></div></nav>
    <section id="about" class="border-line scroll-mt-24 border-y"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.72fr_1.28fr] sm:py-28">
      <h2 class="font-display text-3xl leading-tight font-semibold tracking-[-0.045em] sm:text-5xl" data-home-reveal>{copy.aboutLabel}</h2>
      <div data-home-reveal><p class="font-display max-w-4xl text-3xl leading-tight font-semibold tracking-[-0.04em] sm:text-5xl">{copy.aboutTitle}</p><p class="text-ink-soft mt-7 max-w-2xl leading-7">{copy.aboutBody}</p><div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">{copy.capabilities.map(([title, body]) => <section class="bg-surface p-6"><h3 class="font-display text-lg font-semibold tracking-[-.025em]">{title}</h3><p class="text-ink-soft mt-3 text-sm leading-6">{body}</p></section>)}</div></div>
    </div></section>
    <section id="work" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28">
      <div class="mb-10 flex items-end justify-between border-b border-line pb-5" data-home-reveal><h2 class="font-display text-3xl font-semibold tracking-[-0.04em] sm:text-5xl">{copy.selectedWork}</h2><span class="text-ink-soft font-mono text-xs uppercase">{copy.fiveProjects}</span></div>
      {featured && <div data-home-reveal><FeaturedWork entry={featured} locale={locale} /></div>}
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4" data-home-reveal>{supporting.map((entry, index) => <WorkCard entry={entry} index={index} locale={locale} />)}</div>
      <a href={`${prefix}/work/`} class="border-line hover:border-ink mt-8 inline-flex rounded-full border px-5 py-3 font-mono text-xs uppercase transition-colors">{copy.allWork} →</a>
    </section>
    <section id="contact" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28"><div data-home-reveal><p class="font-display text-ink max-w-5xl text-4xl leading-none font-semibold tracking-[-0.04em] sm:text-7xl">{copy.contactTitle}</p><a href={`mailto:${SITE.email}`} class="text-ink-soft hover:text-ink mt-8 inline-block border-b border-current pb-1 font-mono text-sm transition-colors">{SITE.email} ↗</a></div></section>
  </div>
</BaseLayout>

<script is:inline>
  function setupHomeReveals() {
    const elements = document.querySelectorAll('[data-home-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { elements.forEach((element) => element.classList.add('home-reveal-static')); return; }
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    elements.forEach((element) => { element.classList.add('home-reveal'); observer.observe(element); });
  }
  setupHomeReveals();
  document.addEventListener('astro:page-load', setupHomeReveals);
</script>
<style>.home-reveal { opacity: 0; transform: translateY(28px); transition: opacity 750ms cubic-bezier(.2,.7,.2,1), transform 750ms cubic-bezier(.2,.7,.2,1); } .home-reveal.is-visible, .home-reveal-static { opacity: 1; transform: none; }</style>
