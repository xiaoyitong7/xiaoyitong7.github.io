---
import { SITE } from '@/site.config';
import { UI, type Locale } from '@/i18n';

const year = new Date().getFullYear();
const { locale = 'en' } = Astro.props as { locale?: Locale };
const copy = UI[locale];
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>© {year} {SITE.name}</p>

    <nav class="flex items-center gap-4" aria-label="Social">
      <a href="#top" class="hover:text-signal transition-colors"> {copy.top} ↑ </a>
    </nav>
  </div>
</footer>
