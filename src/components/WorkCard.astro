---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { PROJECT_ZH, UI, type Locale } from '@/i18n';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
  locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const translated = locale === 'zh' ? PROJECT_ZH[entry.id] : undefined;
const { cover, year, accent } = entry.data;
const title = translated?.title ?? entry.data.title;
const summary = translated?.summary ?? entry.data.summary;
const projectType = translated?.projectType ?? entry.data.projectType;
const isOyster = entry.id === 'oyster-reef-revival';
const isProduct = entry.data.layout === 'product';
const prefix = locale === 'zh' ? '/zh' : '';
const copy = UI[locale];
---

<a href={`${prefix}/work/${entry.id}`} class="group block h-full" style={`--accent:${accent}`}>
  <article class="border-line bg-surface flex h-full flex-col overflow-hidden rounded-2xl border transition duration-300 group-hover:-translate-y-1 group-hover:border-[var(--accent)] group-active:translate-y-0">
    <div class="bg-surface relative aspect-[4/3] overflow-hidden">
      {cover ? <Image src={cover} alt={`${title} cover`} class:list={["h-full w-full transition duration-700 group-hover:scale-[1.025]", isProduct ? "object-contain bg-[#0d0d26] p-4" : "object-cover", isOyster && "brightness-[.7] saturate-[1.08] contrast-[.94]"]} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" /> : <div class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_50%_40%,color-mix(in_srgb,var(--accent)_22%,transparent),transparent_58%),linear-gradient(145deg,#15133a,#090914)]"><span class="font-display text-center text-4xl leading-[.9] font-semibold tracking-[-.06em]">Fandom<br /><span style={`color:${accent}`}>MBTI</span></span></div>}
    </div>
    <div class="flex flex-1 flex-col p-5 sm:p-6">
      <div class="mb-5 flex min-h-8 items-start justify-between gap-3 font-mono text-[10px] tracking-[0.14em] uppercase">
        <span class="max-w-[75%]" style={`color:${accent}`}>{projectType}</span>
        <span class="text-ink-soft">{year}</span>
      </div>
      <h3 class="text-ink font-display text-2xl leading-[1.05] font-semibold tracking-[-0.04em] sm:text-3xl">{title}</h3>
      <p class="text-ink-soft mt-4 line-clamp-3 text-sm leading-6">{summary}</p>
      <span class="text-ink mt-auto inline-flex items-center gap-2 pt-6 font-mono text-xs uppercase">{copy.viewCase} <span class="transition-transform group-hover:translate-x-1">→</span></span>
    </div>
  </article>
</a>
