---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { PROJECT_ZH, UI, type Locale } from '@/i18n';

interface Props {
  entry: CollectionEntry<'work'>;
  Content: any;
  locale?: Locale;
}

const { entry, Content, locale = 'en' } = Astro.props;
const translated = locale === 'zh' ? PROJECT_ZH[entry.id] : undefined;
const { year, detailCover } = entry.data;
const title = translated?.title ?? entry.data.title;
const summary = translated?.summary ?? entry.data.summary;
const role = translated?.role ?? entry.data.role;
const projectType = translated?.projectType ?? entry.data.projectType;
const status = translated?.status ?? entry.data.status;
const gallery = entry.data.gallery.map((item, index) => ({ ...item, ...(translated?.gallery[index] ?? {}) }));
const copy = UI[locale];
const prefix = locale === 'zh' ? '/zh' : '';
const heroImage = detailCover;
const flowScreens = gallery.slice(0, 3);
const supportingScreens = gallery.slice(3);
const particles = Array.from({ length: 28 }, (_, index) => ({
  x: (index * 43 + 9) % 100,
  y: (index * 31 + 7) % 100,
  size: 2 + ((index * 5) % 6),
  delay: -((index * 1.2) % 14),
  duration: 10 + ((index * 7) % 12),
}));
---

<article class="product-page relative isolate overflow-hidden text-[#f4f5ef]">
  <div class="signal-field" aria-hidden="true">
    {particles.map((particle) => <span style={`--x:${particle.x}%;--y:${particle.y}%;--size:${particle.size}px;--delay:${particle.delay}s;--duration:${particle.duration}s`}></span>)}
  </div>

  <header class="relative z-10 mx-auto max-w-7xl px-5 pt-12 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
    <a href={`${prefix}/#work`} class="font-mono text-xs uppercase text-white/55 transition-colors hover:text-white">← {copy.selectedWorkBack}</a>
    <h1 class="mx-auto mt-14 max-w-6xl break-words text-center font-display text-[clamp(2.85rem,10vw,9rem)] leading-[.83] font-semibold tracking-[-.075em]" data-product-reveal>{title}</h1>
    {status && <p class="mx-auto mt-8 w-fit rounded-full border border-[#d8e85c]/35 px-4 py-2 font-mono text-[10px] tracking-[.14em] text-[#d8e85c] uppercase" data-product-reveal>{status}</p>}

    <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-0" data-product-reveal>
      <dl class="space-y-8 md:pr-14">
        <div><dt>{copy.type}</dt><dd>{projectType}</dd></div>
        <div><dt>{copy.date}</dt><dd>{year}</dd></div>
        <div><dt>{copy.roleLabel}</dt><dd>{role}</dd></div>
      </dl>
      <div class="product-divider md:border-l md:pl-14">
        <p class="font-display text-2xl leading-snug tracking-[-.025em] text-white/90 sm:text-3xl">{summary}</p>
      </div>
    </div>
  </header>

  <section class="relative z-10 mx-auto max-w-6xl px-5 pb-8 sm:px-8 sm:pb-16" aria-label="Core product flow" data-product-reveal>
    <div class="flow-stage">
      <div class="flow-stage-copy">
        <span>{copy.productFlow}</span>
        <p>{copy.productFlowIntro}</p>
      </div>
      <div class="flow-phones">
        {flowScreens.map((item, index) => item.image && (
          <figure class:list={["flow-phone", `flow-phone-${index + 1}`]}>
            <Image src={item.image} alt={item.alt} class="h-full w-full object-cover object-top" widths={[320, 480, 640]} sizes="(min-width:640px) 25vw, 72vw" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  {heroImage && <div class="relative z-10 mx-auto max-w-[1500px] px-5 sm:px-8" data-product-reveal><div class="overflow-hidden rounded-2xl border border-[#d8e85c]/15 bg-[#09091b]"><Image src={heroImage} alt={`${title} product interface`} class="aspect-[16/9] w-full object-cover" widths={[640, 960, 1440, 1920]} sizes="100vw" /></div></div>}

  <div class="relative z-10 mx-auto max-w-4xl px-5 py-20 sm:px-8 sm:py-32">
    <div class="product-timeline prose prose-invert max-w-none" data-product-reveal>{translated ? translated.sections.map((section) => <><h2>{section.heading}</h2><p>{section.body}</p></>) : <Content />}</div>
  </div>

  <section class="relative z-10 mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-36" aria-labelledby="product-gallery-heading">
    <div class="mb-9 border-b border-white/15 pb-5" data-product-reveal>
      <h2 id="product-gallery-heading" class="font-display text-3xl font-semibold tracking-[-.04em] sm:text-5xl">{copy.aiSocial}</h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {supportingScreens.map((item, index) => <figure class="flex h-full flex-col" data-product-reveal style={`--reveal-delay:${index * 70}ms`}>
        {item.image ? (
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#09091b]"><Image src={item.image} alt={item.alt} class="aspect-[390/844] w-full object-cover object-top transition duration-500 hover:scale-[1.015]" widths={[360, 540, 720]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw" /></div>
        ) : (
          <div class="capture-pending flex aspect-[9/16] items-center justify-center rounded-2xl border border-dashed border-[#d8e85c]/25 bg-[#09091b]/75 px-8 text-center">
            <span class="font-mono text-[10px] leading-6 tracking-[.13em] text-[#d8e85c]/65 uppercase">Authentic Mini Program capture pending login</span>
          </div>
        )}
        <figcaption class="mt-4 min-h-14 text-sm leading-6 text-white/58">{item.caption}</figcaption>
      </figure>)}
    </div>
  </section>

  <nav class="relative z-10 border-t border-white/15"><div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-10 sm:px-8"><a href={`${prefix}/#work`} class="font-mono text-xs uppercase">← {copy.allProjects}</a><a href="#top" class="font-mono text-xs uppercase text-white/55">{copy.backTop} ↑</a></div></nav>
</article>

<script is:inline>
  function setupProductReveals() {
    const elements = document.querySelectorAll('[data-product-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((item) => {
        if (item.isIntersecting) {
          item.target.classList.add('is-visible');
          observer.unobserve(item.target);
        }
      });
    }, { threshold: .12, rootMargin: '0px 0px -7% 0px' });
    elements.forEach((element) => {
      element.classList.add('product-reveal');
      observer.observe(element);
    });
  }
  setupProductReveals();
  document.addEventListener('astro:page-load', setupProductReveals);
</script>

<style>
  .product-page {
    background:
      radial-gradient(circle at 50% 3%, rgba(216, 232, 92, .08), transparent 32rem),
      linear-gradient(180deg, #11140c 0%, #0a0c08 38%, #060706 72%, #030303 100%);
  }
  .signal-field { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .signal-field span { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 999px; background: #d8e85c; opacity: 0; box-shadow: 0 0 13px rgba(216,232,92,.7); animation: signal-drift var(--duration) ease-in-out var(--delay) infinite; }
  .product-divider { border-color: rgba(216,232,92,.23); }
  dt { color: rgba(216,232,92,.72); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; }
  dd { margin-top: .55rem; max-width: 27rem; color: rgba(255,255,255,.92); font-size: 1rem; line-height: 1.55; }
  .product-timeline { --tw-prose-body: rgba(244,245,239,.7); --tw-prose-headings: #f4f5ef; position: relative; padding-left: clamp(3.25rem, 6vw, 5.5rem); }
  .product-timeline::before { content: ''; position: absolute; top: 2.1rem; bottom: 8.7rem; left: clamp(.55rem,1.5vw,1.25rem); width: 1px; background: linear-gradient(180deg, transparent, #d8e85c 12%, #d8e85c 88%, transparent); opacity: .62; }
  .product-timeline :global(h2) { position: relative; margin-top: 5rem; font-family: var(--font-display); font-size: clamp(2rem,5vw,4rem); line-height: .98; letter-spacing: -.04em; }
  .product-timeline :global(h2:first-child) { margin-top: 0; }
  .product-timeline :global(h2::before) { content: ''; position: absolute; top: .35em; left: calc(-1 * clamp(3.25rem,6vw,5.5rem) + clamp(.55rem,1.5vw,1.25rem) - .38rem); width: .78rem; height: .78rem; border: 1px solid #d8e85c; border-radius: 999px; background: #10130b; box-shadow: 0 0 0 5px rgba(216,232,92,.07), 0 0 20px rgba(216,232,92,.2); }
  .flow-stage { overflow: hidden; border: 1px solid rgba(216,232,92,.14); border-radius: 1rem; background: linear-gradient(145deg, rgba(216,232,92,.075), rgba(255,255,255,.015) 50%, rgba(0,0,0,.18)); padding: clamp(1.25rem,4vw,3rem); }
  .flow-stage-copy { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.5rem,4vw,3rem); }
  .flow-stage-copy span { color: #d8e85c; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; }
  .flow-stage-copy p { margin: 0; color: rgba(255,255,255,.52); font-size: .875rem; }
  .flow-phones { display: flex; align-items: center; justify-content: center; gap: clamp(.7rem,2vw,1.4rem); perspective: 1000px; }
  .flow-phone { aspect-ratio: 390 / 844; width: min(29%, 15rem); overflow: hidden; border: 1px solid rgba(216,232,92,.16); border-radius: 1.2rem; background: #080a06; box-shadow: 0 1.7rem 4.5rem rgba(0,0,0,.45); }
  .flow-phone-1 { transform: translateY(5%) rotate(-3deg); }
  .flow-phone-2 { transform: translateY(-2%); z-index: 2; }
  .flow-phone-3 { transform: translateY(5%) rotate(3deg); }
  .product-timeline :global(p) { max-width: 46rem; font-size: 1.08rem; line-height: 1.85; }
  .product-reveal { opacity: 0; transform: translateY(34px); transition: opacity 820ms cubic-bezier(.2,.7,.2,1) var(--reveal-delay,0ms), transform 820ms cubic-bezier(.2,.7,.2,1) var(--reveal-delay,0ms); }
  .product-reveal.is-visible { opacity: 1; transform: none; }
  @keyframes signal-drift { 0% { transform: translate3d(0,18px,0) scale(.75); opacity: 0; } 24% { opacity: .22; } 72% { opacity: .1; } 100% { transform: translate3d(12px,-100px,0) scale(1.1); opacity: 0; } }
  @media (max-width:639px) { .product-timeline::before { bottom: 11rem; } .flow-stage-copy { align-items: flex-start; flex-direction: column; } .flow-phones { justify-content: flex-start; overflow-x: auto; margin-inline: -1.25rem; padding: .5rem 1.25rem 1.5rem; scroll-snap-type: x mandatory; } .flow-phone { flex: 0 0 72vw; width: 72vw; scroll-snap-align: center; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .signal-field { display: none; } .product-reveal { opacity: 1; transform: none; transition: none; } }
</style>
