---
import { SITE } from '@/site.config';
import { UI, localizedPath, type Locale } from '@/i18n';

const currentPath = Astro.url.pathname;
const { locale = 'en' } = Astro.props as { locale?: Locale };
const copy = UI[locale];
const prefix = locale === 'zh' ? '/zh' : '';
const navLinks = [
  { label: copy.about, href: `${prefix}/#about` },
  { label: copy.work, href: `${prefix}/#work` },
];
const switchHref = localizedPath(currentPath, locale);
---

<header class="border-line bg-paper/85 sticky top-0 z-40 border-b backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={`${prefix}/`} class="font-mono text-ink text-sm font-bold tracking-[0.14em] uppercase">
      {SITE.name}
    </a>

    <nav class="flex items-center gap-4 sm:gap-7" aria-label="Primary">
      {
        navLinks.map((link, index) => {
          const isActive = link.href.startsWith('/#') ? false : currentPath === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                index < 2 && 'hidden sm:inline',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a href={switchHref} lang={locale === 'en' ? 'zh-CN' : 'en'} aria-label={copy.languageLabel} class="text-ink-soft hover:text-ink font-mono text-[10px] tracking-wide uppercase transition-colors sm:text-xs">{copy.language}</a>
      <a href={`${prefix}/#contact`} class="border-line hover:border-ink text-ink rounded-full border px-3 py-1.5 font-mono text-[10px] tracking-wide uppercase transition-colors sm:px-4 sm:text-xs">{copy.contact}</a>
    </nav>
  </div>
</header>
